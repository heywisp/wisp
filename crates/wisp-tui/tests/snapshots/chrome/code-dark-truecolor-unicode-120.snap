|   use std::collections::BTreeMap;                                                                                 rust
  ~ 115..119 fg Rgb(117, 117, 117)
|
|   pub struct Fingerprint {
|       system: u64,
|       tools: u64,
|       messages: Vec<u64>,
|   }
|
|   impl Fingerprint {
|       pub fn of(req: &Request) -> Result<Fingerprint, Error> {
|           let system = hash(&req.system);
|           let tools = hash(&req.tools);
|           let messages = req.messages.iter().map(hash).collect();
|           Ok(Fingerprint { system, tools, messages })
|       }
|
|       pub fn cause(&self, before: &Fingerprint) -> Option<&'static str> {
|           if self.system != before.system {
|               return Some("system changed");
|           }
|           if self.tools != before.tools {
|               return Some("tools changed");
|           }
|           None
|       }
|   }
|
|   The test covers each cause.
