{"model":"claude-opus-5-5","max_tokens":64000,"stream":true,"thinking":{"type":"adaptive","display":"summarized","block_binding":{"prefix_mismatch_behavior":"drop_block"}},"output_config":{"effort":"medium"},"cache_control":{"type":"ephemeral","ttl":"1h"},"fallbacks":"default","tools":[{"description":"Show the user a diff in the chat. Use it when you want the user to see a change: one you propose, one you made, or a comparison they asked for. It only displays the diff: it changes no files and runs nothing, so it never applies a change. The user sees the diff with changed words and syntax highlighted, so don't repeat it in your reply.\n\nGive each file as `before` and `after` (the old and new text; Wisp computes the diff and shows 3 unchanged lines around each change) or as `diff` (a unified diff you wrote; wrong hunk line counts are recounted, and hunk headers without line numbers are accepted). Give `path` so the code gets syntax colours, or `language` when there is no path. Limits: 20 files, 10,000 lines and 512 KiB for each side of a file, 1 MiB in all.","input_schema":{"additionalProperties":false,"properties":{"files":{"description":"The files to show, in order, one entry per file.","items":{"additionalProperties":false,"properties":{"after":{"description":"The new text. Use \"\" for a deleted file.","type":"string"},"before":{"description":"The old text. Use \"\" for a new file.","type":"string"},"diff":{"description":"A unified diff of this file, instead of before and after.","type":"string"},"language":{"description":"The language for syntax colours when path doesn't show it, such as rust.","type":"string"},"path":{"description":"The file's path, shown to the user.","type":"string"}},"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"title":{"description":"A short heading for the diff, such as what the change does.","type":"string"}},"required":["files"],"type":"object"},"name":"show_diff"}],"system":[{"type":"text","text":"You are Wisp, a helpful assistant running in a terminal. Answer clearly and concisely; use plain text and Markdown sparingly. You can show the user a change as a diff with the show_diff tool. A user message may begin with a 'Sent:' line that Wisp adds, giving the time it was sent; use it for anything involving dates or time, and don't mention it otherwise. A 'Context:' line, when present, gives how much of your context window the conversation fills; at the stated point Wisp replaces older turns with a summary.","cache_control":{"type":"ephemeral","ttl":"1h"}}],"messages":[{"role":"user","content":[{"type":"text","text":"Sent: <masked> UTC+05:30\n"},{"type":"text","text":"Context: <masked> of 1M tokens (0%). Wisp compacts at 850k.\n"},{"type":"text","text":"hello"}]}]}
