package wisp:plugin@0.4.0;

interface questions {
  use wisp:plugin/call@0.1.0.{call-context};
  use wisp:plugin/types@0.1.0.{question};
  enum posted { open, busy, unavailable }
  post: async func(items: list<question>, ctx: borrow<call-context>) -> posted;
  withdraw: async func(ctx: borrow<call-context>) -> bool;
}
