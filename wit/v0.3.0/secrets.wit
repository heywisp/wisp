package wisp:plugin@0.3.0;

interface secrets {
  use wisp:plugin/call@0.1.0.{call-context};
  record secret-ask { process: u32, name: string, reason: string, end-input: bool, show-start: u8, show-end: u8 }
  enum secret-refusal { no-process, ended, shows-input, no-input, attached, too-long }
  variant secret-end { typed, process-ended, unavailable, stopped, refused(secret-refusal), failed }
  type-into: async func(ask: secret-ask, ctx: borrow<call-context>) -> secret-end;
}
